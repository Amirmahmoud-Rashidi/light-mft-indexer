{
  "name": "mft-indexer",
  "version": "1.1.0",
  "description": "Fast MFT-based file indexer with MCP server - WizTree alternative",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mft-indexer": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start:mcp": "node dist/mcp/server.js",
    "index": "node dist/cli/index.js index",
