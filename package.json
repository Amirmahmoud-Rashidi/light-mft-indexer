{
  "name": "mft-indexer",
  "version": "1.0.0",
  "description": "Fast MFT-based file indexer with MCP server - WizTree alternative",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "start:mcp": "node dist/mcp/server.js",
    "index": "node dist/cli/index.js",
    "dev": "ts-node src/cli/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "mft",
    "ntfs",
    "file-indexer",
    "wiztree",
    "mcp",
    "vector-database"
